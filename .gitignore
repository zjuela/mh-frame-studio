# build output
dist/
.output/

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*


# environment variables
.env
.env.production

# macOS-specific files
.DS_Store

# pnpm-specific files: pnpm is supported for local use (see .pnpmrc), but
# package-lock.json is the tracked lockfile and npm is what CI, Docker and
# the deploy targets run. Committing these would let the two trees diverge.
pnpm-lock.yaml
pnpm-workspace.yaml

.astro


# Only what the website uses is committed. The generators that build the
# Reels, ad mock-ups, social posts and before/afters, and the source photos
# and clips only they read, stay on this machine. Their output (in
# src/assets/images/ and public/videos/) is committed.
