---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import Prices from '~/components/widgets/Pricing.astro';
import Comparison from '~/components/widgets/Comparison.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import Button from '~/components/ui/Button.astro';
import { getPermalink } from '~/utils/permalinks';

const trial = `${getPermalink('/contact')}#trial`;
const contact = getPermalink('/contact');

const metadata = {
  title: 'Pricing',
  description:
    'Monthly plans, social post packages and per-item prices for dental photo and video editing and social media content.',
};
---

<Layout metadata={metadata}>
  <HeroText
    tagline="Pricing"
    title="Simple plans. No contracts."
    subtitle="Pick a monthly plan, or pay per item. One new patient is often worth $3,000 or more to a practice; our Starter plan costs about $10 a day."
  />

  <Prices
    title="Editing plans"
    subtitle="Our three core services: before/afters, Reels and patient testimonials. Savings compare each plan with the per-item prices below."
    prices={[
      {
        title: 'Starter',
        subtitle: 'For practices getting consistent online',
        price: 299,
        period: 'per month',
        saving: 'Save 37%',
        note: '$474 of work at per-item prices',
        items: [
          { description: '20 photo edits (10 before/after sets)' },
          { description: '6 Reels from your phone footage' },
          { description: '48h turnaround' },
          { description: '2 revision rounds' },
        ],
        callToAction: { text: 'Start free trial', href: trial },
      },
      {
        title: 'Growth',
        subtitle: 'For practices posting every week',
        price: 499,
        period: 'per month',
        saving: 'Save 40%',
        note: '$831 of work at per-item prices',
        items: [
          { description: '30 photo edits (15 before/after sets)' },
          { description: '8 Reels from your phone footage' },
          { description: '1 patient testimonial (full cut + clips)' },
          { description: '24h photo turnaround' },
          { description: 'Dedicated editor' },
        ],
        callToAction: { variant: 'primary', text: 'Start free trial', href: trial },
        hasRibbon: true,
        ribbonTitle: 'popular',
        highlight: true,
      },
      {
        title: 'Pro',
        subtitle: 'For multi-chair and cosmetic practices',
        price: 899,
        period: 'per month',
        saving: 'Save 46%',
        note: '$1,662 of work at per-item prices',
        items: [
          { description: '60 photo edits (30 before/after sets)' },
          { description: '16 Reels from your phone footage' },
          { description: '2 patient testimonials (full cut + clips)' },
          { description: '24h photos, priority video' },
          { description: 'Dedicated editor' },
        ],
        callToAction: { text: 'Start free trial', href: trial },
      },
    ]}
  />

  <section class="px-4 pb-12 md:pb-16" aria-labelledby="agency-pricing">
    <div
      class="mx-auto flex max-w-5xl flex-col gap-6 rounded-2xl border border-primary/20 bg-primary/5 p-6 md:flex-row md:items-center md:justify-between md:p-8 dark:bg-primary/10"
    >
      <div>
        <p class="text-sm font-semibold uppercase tracking-wide text-primary dark:text-secondary">For agencies</p>
        <h2 id="agency-pricing" class="mt-1 font-heading text-2xl font-bold text-heading md:text-3xl">
          From $349 per clinic / month
        </h2>
        <p class="mt-2 max-w-2xl text-muted">
          Wholesale, white-label pricing: 8 Reels and 20 photo edits per clinic, no setup fee. 10% off at 5+ clinics,
          15% off at 10+. Free test project.
        </p>
      </div>
      <Button text="See agency plan" href={getPermalink('/agencies')} icon="tabler:arrow-right" class="shrink-0" />
    </div>
  </section>

  <Prices
    id="social"
    title="Social post packages"
    subtitle="Custom posts in your brand, made from your photos and delivered ready to post with captions and hashtags. Add one to an editing plan and get 10% off the package."
    prices={[
      {
        title: 'Social Lite',
        subtitle: 'For a steady presence',
        price: 129,
        period: 'per month',
        saving: 'Save 33%',
        note: '$192 of work at per-item prices',
        items: [
          { description: '6 single-image posts' },
          { description: '2 carousels (5–7 slides)' },
          { description: 'Captions and hashtags' },
          { description: '2 revision rounds' },
        ],
        callToAction: { text: 'Get started', href: contact },
      },
      {
        title: 'Social Plus',
        subtitle: 'For posting 3–4 times a week',
        price: 279,
        period: 'per month',
        saving: 'Save 38%',
        note: '$453 of work at per-item prices',
        items: [
          { description: '12 single-image posts' },
          { description: '4 carousels (5–7 slides)' },
          { description: '1 Meta ad creative' },
          { description: 'Captions and hashtags' },
        ],
        callToAction: { text: 'Get started', href: contact },
        highlight: true,
      },
      {
        title: 'Social Pro',
        subtitle: 'For daily posting and ads',
        price: 449,
        period: 'per month',
        saving: 'Save 40%',
        note: '$754 of work at per-item prices',
        items: [
          { description: '16 single-image posts' },
          { description: '8 carousels (5–7 slides)' },
          { description: '2 Meta ad creatives' },
          { description: 'Monthly content calendar' },
        ],
        callToAction: { text: 'Get started', href: contact },
      },
    ]}
  />

  <Comparison
    title="Pay per item"
    subtitle="No plan needed. Prices are starting points; complex jobs are quoted upfront."
    firstColumnLabel="Service"
    columns={[{ title: 'From' }, { title: 'Turnaround' }]}
    rows={[
      {
        group: 'Core services',
        label: 'Before/after set',
        description: 'Two matched photos, labelled layout',
        values: ['$12', '24–48h'],
      },
      { label: 'Reel / TikTok / Short', description: 'Up to 60 seconds', values: ['$59', '48–72h'] },
      { label: 'Transformation Reel', description: 'Before/after reveal video', values: ['$69', '48–72h'] },
      { label: 'Patient testimonial', description: 'Full cut + 2 short clips', values: ['$179', '3–4 days'] },
      {
        group: 'Social posts',
        label: 'Single-image post',
        description: 'Your photo or a branded design, with caption',
        values: ['$19', '48h'],
      },
      { label: 'Carousel', description: '5–7 slides, with caption', values: ['$39', '48–72h'] },
      { label: 'Story set', description: '3 frames', values: ['$19', '48h'] },
      {
        label: 'Meta ad creative',
        description: 'One ad, 3 hook variations, 3 formats',
        values: ['$69', '48–72h'],
      },
      {
        group: 'Add-ons',
        label: 'Google profile photo pack',
        description: '10 office, team or exterior photos',
        values: ['$59', '48h'],
      },
      { group: 'Also available', label: 'Clinical / intraoral photo', values: ['$4', '24–48h'] },
      { label: 'Team headshot', values: ['$12', '24–48h'] },
      { label: 'Doctor intro / clinic tour', description: 'Up to 3 minutes', values: ['$249', '3–5 days'] },
      { label: 'Same-day rush', description: 'Any item', values: ['+50%', 'Same day'] },
    ]}
  />

  <FAQs
    title="Pricing questions"
    items={[
      { title: 'Is there a contract?', description: 'No. Plans are month-to-month and you can cancel any time.' },
      {
        title: 'How do plan allowances work?',
        description: 'Plans count photo edits; a before/after set uses 2. Unused edits roll over for one month.',
      },
      {
        title: 'Do you post for us?',
        description:
          'No. Social packages are delivered as ready-to-post files with captions and hashtags, so you stay in control of your accounts.',
      },
      {
        title: 'Can I combine an editing plan and a social package?',
        description: 'Yes. Add any social package to an editing plan and get 10% off the package.',
      },
      {
        title: 'Do you offer rush delivery?',
        description: 'Yes — same-day delivery is available for +50% on any item.',
      },
      {
        title: 'Is there a discount for paying ahead?',
        description: 'Yes. Pay quarterly and get 10% off any plan.',
      },
      {
        title: 'How do I pay?',
        description: 'By card or bank transfer. Monthly plans are billed at the start of each month.',
      },
    ]}
  />

  <CallToAction
    title="Try us before you pay"
    subtitle="3 free photo edits. No card needed."
    actions={[{ variant: 'primary', text: 'Start free trial', href: trial, icon: 'tabler:gift' }]}
  />
</Layout>
