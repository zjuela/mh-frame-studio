---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import Prices from '~/components/widgets/Pricing.astro';
import Comparison from '~/components/widgets/Comparison.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import { getPermalink } from '~/utils/permalinks';

const metadata = {
  title: 'Pricing',
  description: 'Simple monthly plans and per-item prices for dental photo and video editing.',
};
---

<Layout metadata={metadata}>
  <HeroText
    tagline="Pricing"
    title="Simple plans. No contracts."
    subtitle="Pick a monthly plan, or pay per item. Unused photo edits roll over for one month."
  />

  <Prices
    prices={[
      {
        title: 'Clinic Starter',
        subtitle: 'For practices getting consistent online',
        price: 149,
        period: 'per month',
        items: [
          { description: '20 photo edits (before/after or clinical)' },
          { description: '2 short vertical videos' },
          { description: '48h turnaround' },
          { description: '2 revision rounds' },
        ],
        callToAction: { text: 'Start free trial', href: `${getPermalink('/contact')}#trial` },
      },
      {
        title: 'Practice Growth',
        subtitle: 'For practices posting every week',
        price: 399,
        period: 'per month',
        items: [
          { description: '50 photo edits' },
          { description: '8 short vertical videos' },
          { description: '1 patient testimonial video' },
          { description: '24h photo turnaround' },
          { description: 'Dedicated editor' },
        ],
        callToAction: { variant: 'primary', text: 'Start free trial', href: `${getPermalink('/contact')}#trial` },
        hasRibbon: true,
        ribbonTitle: 'popular',
        highlight: true,
      },
      {
        title: 'Agency',
        subtitle: 'White-label for marketing agencies',
        price: 'Custom',
        period: 'volume pricing',
        items: [
          { description: 'Volume pricing across all your clinics' },
          { description: 'White-label delivery' },
          { description: 'Dedicated editor & shared channel' },
          { description: 'Brand presets per clinic' },
        ],
        callToAction: { text: 'See agency plan', href: getPermalink('/agencies') },
      },
    ]}
  />

  <Comparison
    title="Pay per item"
    subtitle="No plan needed. Prices are starting points; complex jobs are quoted upfront."
    firstColumnLabel="Service"
    columns={[{ title: 'From' }, { title: 'Turnaround' }]}
    rows={[
      {
        group: 'Photo',
        label: 'Before/after set',
        description: 'Two matched photos + layout',
        values: ['$8', '24–48h'],
      },
      { label: 'Clinical / intraoral photo', values: ['$4', '24–48h'] },
      { label: 'Headshot retouch', values: ['$10', '24–48h'] },
      { label: 'Office / interior photo', values: ['$6', '24–48h'] },
      { group: 'Video', label: 'Reel / TikTok / Short', description: 'Up to 60 seconds', values: ['$45', '48–72h'] },
      { label: 'Smile reveal video', values: ['$60', '48–72h'] },
      { label: 'Patient testimonial', description: 'Full cut + 2 short clips', values: ['$120', '3–4 days'] },
      { label: 'Doctor intro / clinic tour', description: 'Up to 3 minutes', values: ['$180', '3–5 days'] },
    ]}
  />

  <FAQs
    title="Pricing questions"
    items={[
      { title: 'Is there a contract?', description: 'No. Plans are month-to-month and you can cancel any time.' },
      {
        title: 'What counts as a photo edit?',
        description: 'One delivered image. A before/after set counts as two edits.',
      },
      {
        title: 'Do you offer rush delivery?',
        description: 'Yes — same-day delivery is available for +50% on any item.',
      },
      {
        title: 'How do I pay?',
        description: 'By card or bank transfer. Monthly plans are billed at the start of each month.',
      },
    ]}
  />

  <CallToAction
    title="Try us before you pay"
    subtitle="3 free photo edits. No card needed."
    actions={[
      { variant: 'primary', text: 'Start free trial', href: `${getPermalink('/contact')}#trial`, icon: 'tabler:gift' },
    ]}
  />
</Layout>
