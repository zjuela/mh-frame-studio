---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import Prices from '~/components/widgets/Pricing.astro';
import Comparison from '~/components/widgets/Comparison.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import Button from '~/components/ui/Button.astro';
import SectionNav from '~/components/ui/SectionNav.astro';
import { getPermalink } from '~/utils/permalinks';
import { PAYG_RATE, agency, cost, creditsFor, savingPercent, type Service } from '~/data/credits';

const trial = `${getPermalink('/contact')}#trial`;
const contact = getPermalink('/contact');

const metadata = {
  title: 'Pricing',
  description:
    'Credit-based monthly plans and pay-as-you-go prices for dental photo and video editing and social media content.',
};

// Plans include credits each month, and a practice can hold one core plan and
// one social plan at most, with both adding to one balance that works on any
// service. The credit chart lives in src/data/credits.ts. Keep the price per
// credit falling as plans get bigger, across both plan groups.

/** A plan card: its credits are the sum of a typical month's work. */
const plan = (
  title: string,
  subtitle: string,
  price: number,
  month: Array<[number, Service, string]>,
  extras: string[],
  callToAction: { text: string; href: string; variant?: 'primary' },
  more: { highlight?: boolean; hasRibbon?: boolean; ribbonTitle?: string } = {}
) => {
  const credits = creditsFor(month);
  const value = credits * PAYG_RATE;
  return {
    title,
    subtitle,
    price,
    period: 'per month',
    credits: `${credits} credits a month`,
    saving: `Save ${savingPercent(price, credits)}%`,
    note: `$${value.toLocaleString('en-US')} at pay-as-you-go rates`,
    itemsTitle: 'A typical month',
    items: [
      ...month.map(([n, service, label]) => ({ description: `${label} · ${n * cost[service]} credits` })),
      ...extras.map((description) => ({ description, icon: 'tabler:plus' })),
    ],
    callToAction,
    ...more,
  };
};

const startTrial = { text: 'Start free trial', href: trial };
const getStarted = { text: 'Get started', href: contact };

const corePlans = [
  plan(
    'Starter',
    'For practices getting consistent online',
    299,
    [
      [10, 'set', '10 before/after sets'],
      [4, 'reel', '4 Reels'],
    ],
    ['48h turnaround'],
    startTrial
  ),
  plan(
    'Growth',
    'For practices posting every week',
    499,
    [
      [15, 'set', '15 before/after sets'],
      [5, 'reel', '5 Reels'],
      [1, 'testimonial', '1 patient testimonial'],
    ],
    ['24h photo turnaround', 'Dedicated editor'],
    { ...startTrial, variant: 'primary' },
    { highlight: true, hasRibbon: true, ribbonTitle: 'popular' }
  ),
  plan(
    'Pro',
    'For multi-chair and cosmetic practices',
    899,
    [
      [30, 'set', '30 before/after sets'],
      [10, 'reel', '10 Reels'],
      [2, 'testimonial', '2 patient testimonials'],
    ],
    ['24h photos, priority video', 'Dedicated editor'],
    startTrial
  ),
];

const socialPlans = [
  plan(
    'Social Lite',
    'For a steady presence',
    119,
    [
      [5, 'post', '5 single-image posts'],
      [1, 'carousel', '1 carousel'],
    ],
    ['Captions and hashtags'],
    getStarted
  ),
  plan(
    'Social Plus',
    'For posting 2–3 times a week',
    265,
    [
      [8, 'post', '8 single-image posts'],
      [2, 'carousel', '2 carousels'],
      [1, 'ad', '1 Meta ad creative'],
    ],
    ['Captions and hashtags'],
    { ...getStarted, variant: 'primary' },
    { highlight: true }
  ),
  plan(
    'Social Pro',
    'For posting 4–5 times a week, plus ads',
    449,
    [
      [12, 'post', '12 single-image posts'],
      [4, 'carousel', '4 carousels'],
      [2, 'ad', '2 Meta ad creatives'],
    ],
    ['Monthly content calendar'],
    getStarted
  ),
];

const row = (service: Service, label: string, turnaround: string, description?: string) => ({
  label,
  description,
  values: [String(cost[service]), `$${cost[service] * PAYG_RATE}`, turnaround],
});
---

<Layout metadata={metadata}>
  <HeroText
    tagline="Pricing"
    title="Monthly credits. Spend them your way."
    subtitle="Pick a core plan, a social plan, or one of each. Credits go into one balance that works on any service. One new patient is often worth $3,000 or more to a practice; our Starter plan costs about $10 a day."
  />

  <SectionNav
    label="Pricing sections"
    items={[
      { text: 'Core plans', href: '#core-plans' },
      { text: 'Social plans', href: '#social-plans' },
      { text: 'Pay per item', href: '#per-item' },
    ]}
  />

  <Prices
    id="core-plans"
    title="Core plans"
    subtitle="Sized for our three core services: before/afters, Reels and patient testimonials. Credits work on any service in the credit chart. Choose one core plan."
    prices={corePlans}
  />

  <section class="px-4 pb-12 md:pb-16" aria-labelledby="agency-pricing">
    <div
      class="mx-auto flex max-w-5xl flex-col gap-6 rounded-2xl border border-primary/20 bg-primary/5 p-6 md:flex-row md:items-center md:justify-between md:p-8 dark:bg-primary/10"
    >
      <div>
        <p class="text-sm font-semibold uppercase tracking-wide text-primary dark:text-secondary">For agencies</p>
        <h2 id="agency-pricing" class="mt-1 font-heading text-2xl font-bold text-heading md:text-3xl">
          From ${agency.pricePerClinic} per clinic / month
        </h2>
        <p class="mt-2 max-w-2xl text-muted">
          Wholesale, white-label pricing: {agency.creditsPerClinic} credits per clinic (about 6 Reels and 10 before/after
          sets), no setup fee. 10% off at 5+ clinics, 15% off at 10+. Free test project.
        </p>
      </div>
      <Button text="See agency plan" href={getPermalink('/agencies')} icon="tabler:arrow-right" class="shrink-0" />
    </div>
  </section>

  <Prices
    id="social-plans"
    title="Social plans"
    subtitle="Sized for custom posts and Meta ads in your brand, made from your photos and delivered ready to post. Choose one social plan, on its own or with a core plan for 10% off."
    prices={socialPlans}
    bg='<div class="absolute inset-0 bg-slate-50 dark:bg-transparent"></div>'
  />

  <Comparison
    id="per-item"
    title="Pay per item"
    subtitle={`The credit chart: what each service costs in credits. No plan? Pay as you go at $${PAYG_RATE} per credit. Complex jobs are quoted upfront.`}
    firstColumnLabel="Service"
    columns={[{ title: 'Credits' }, { title: 'Pay as you go' }, { title: 'Turnaround' }]}
    rows={[
      { group: 'Core services', ...row('set', 'Before/after set', '24–48h', 'Two matched photos, labelled layout') },
      row('reel', 'Reel / TikTok / Short', '48–72h', 'Up to 60 seconds'),
      row('transformation', 'Transformation Reel', '48–72h', 'Before/after reveal video'),
      row('testimonial', 'Patient testimonial', '3–4 days', 'Full cut + 2 short clips'),
      { group: 'Social', ...row('post', 'Single-image post', '48h', 'Your photo or a branded design, with caption') },
      row('carousel', 'Carousel', '48–72h', '5–7 slides, with caption'),
      row('story', 'Story set', '48h', '3 frames'),
      row('ad', 'Meta ad creative', '48–72h', 'One ad, 3 hook variations, 3 formats'),
      { group: 'Also available', ...row('googlePack', 'Google profile photo pack', '48h', '10 photos') },
      row('clinical', 'Clinical / intraoral photo', '24–48h'),
      row('headshot', 'Team headshot', '24–48h'),
      row('intro', 'Doctor intro / clinic tour', '3–5 days', 'Up to 3 minutes'),
      { label: 'Same-day rush', description: 'Any item', values: ['+50%', '+50%', 'Same day'] },
    ]}
  />

  <FAQs
    title="Pricing questions"
    items={[
      { title: 'Is there a contract?', description: 'No. Plans are month-to-month and you can cancel any time.' },
      {
        title: 'How do credits work?',
        description:
          'Each plan adds credits at the start of the month, and every service costs a set number of credits (see the credit chart). Spend them on any mix: more Reels one month, more posts the next. Unused credits roll over for one month.',
      },
      {
        title: 'What if I run out of credits?',
        description: 'Top up any time at the same per-credit rate as your plan, or move up a plan.',
      },
      {
        title: 'Can I have more than one plan?',
        description:
          'You can have one core plan and one social plan. Their credits go into one balance, and you get 10% off the social plan. To get more within a group, move up a plan or top up.',
      },
      {
        title: 'Do you post for us?',
        description:
          'No. Social content is delivered as ready-to-post files with captions and hashtags, so you stay in control of your accounts.',
      },
      {
        title: 'Is there a discount for paying ahead?',
        description: 'Yes. Pay quarterly and get 10% off any plan.',
      },
      {
        title: 'How do I pay?',
        description: 'By card or bank transfer. Monthly plans are billed at the start of each month.',
      },
    ]}
  />

  <CallToAction
    title="Try us before you pay"
    subtitle="3 free photo edits. No card needed."
    actions={[{ variant: 'primary', text: 'Start free trial', href: trial, icon: 'tabler:gift' }]}
  />
</Layout>
