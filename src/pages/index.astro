---
import Layout from '~/layouts/PageLayout.astro';

import Hero2 from '~/components/widgets/Hero2.astro';
import Features from '~/components/widgets/Features.astro';
import Features2 from '~/components/widgets/Features2.astro';
import ServiceSlide from '~/components/widgets/ServiceSlide.astro';
import Reels from '~/components/widgets/Reels.astro';
import Steps from '~/components/widgets/Steps.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import StickyCTA from '~/components/widgets/StickyCTA.astro';
import BeforeAfter from '~/components/ui/BeforeAfter.astro';
import StructuredData from '~/components/common/StructuredData.astro';

import { pairs, reels } from '~/data/samples';
import { getPermalink } from '~/utils/permalinks';
import { SITE, I18N } from 'astrowind:config';

const metadata = {
  title: 'M&H Frame Studio — Photo & Video Editing for Dental Practices',
  ignoreTitleTemplate: true,
};

const trial = `${getPermalink('/contact')}#trial`;

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'ProfessionalService',
    name: SITE?.name,
    url: SITE?.site,
    inLanguage: I18N?.language,
    description:
      'Photo and video editing for dentists and dental marketing agencies: compliance-ready before/afters, Reels from phone footage, patient testimonials and Meta ad creatives.',
  },
];
---

<Layout metadata={metadata} slides>
  <StructuredData slot="head" schema={structuredData} />

  <Hero2
    tagline="Editing for dentists & dental marketing agencies"
    actions={[
      { variant: 'primary', text: 'Get 3 free edits', href: trial, icon: 'tabler:gift' },
      { text: 'See our work', href: getPermalink('/work') },
    ]}
  >
    <Fragment slot="title">
      You film it on a phone. We make it <span class="text-accent">book patients</span>.
    </Fragment>
    <Fragment slot="subtitle">
      Compliance-ready before/afters, Reels and patient testimonials — edited from the photos and clips already on your
      team's phones, back in 24–48 hours.
    </Fragment>
    <Fragment slot="image">
      <BeforeAfter before={pairs.smile.before} after={pairs.smile.after} alt={pairs.smile.alt} start={45} eager />
    </Fragment>
  </Hero2>

  <div class="slide">
    <Features
      id="trust"
      columns={4}
      classes={{ container: 'py-8 md:py-10 lg:py-12' }}
      items={[
        {
          title: 'Compliance-ready',
          description: 'We fix the photo, never the clinical result.',
          icon: 'tabler:shield-check',
        },
        { title: '24–48h turnaround', description: 'Same-day rush available.', icon: 'tabler:clock-hour-4' },
        { title: 'White-label for agencies', description: 'No branding of ours, ever.', icon: 'tabler:tag-off' },
        {
          title: 'Patient privacy',
          description: 'Encrypted transfer, files deleted after delivery.',
          icon: 'tabler:lock',
        },
      ]}
    >
      <Fragment slot="bg">
        <div class="absolute inset-0 bg-primary/5 dark:bg-transparent"></div>
      </Fragment>
    </Features>

    <Features2
      id="who"
      tagline="Who we help"
      title="Built for two kinds of clients"
      columns={2}
      items={[
        {
          title: 'Dental practices',
          description:
            'Your team has great before/afters and patient moments on their phones — but no time to edit and post them. Send them to us and get ready-to-post content back, without hiring or learning editing software.',
          icon: 'tabler:dental',
          href: getPermalink('/services'),
        },
        {
          title: 'Dental marketing agencies',
          description:
            'Add editing capacity without hiring. We edit Reels, testimonials, before/afters and Meta ad creatives for all your dental clients — white-label, with brand presets per clinic and overnight turnaround.',
          icon: 'tabler:briefcase',
          href: getPermalink('/agencies'),
        },
      ]}
    />
  </div>

  <ServiceSlide
    id="before-after"
    tagline="Core service 1"
    title="Compliance-ready before/afters"
    subtitle="Matched, honest pairs your practice can post with confidence. Drag the slider to compare."
    items={[
      { title: 'Matched pairs', description: 'Same light, colour, angle and crop on both shots.' },
      { title: 'Never altered', description: 'Tooth shape, shade and gum line are never touched.' },
      { title: 'Labels included', description: 'Procedure name and a "results may vary" line.' },
      { title: 'Ad-friendly versions', description: 'For platforms that restrict side-by-sides.' },
    ]}
    callToAction={{ text: 'More about before/afters', href: `${getPermalink('/services')}#before-after` }}
  >
    <BeforeAfter slot="media" before={pairs.consult.before} after={pairs.consult.after} alt={pairs.consult.alt} />
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-slate-50 dark:bg-transparent"></div>
    </Fragment>
  </ServiceSlide>

  <ServiceSlide
    id="reels"
    isReversed
    tagline="Core service 2"
    title="Reels from phone footage"
    subtitle="Raw clips turned into 15–60 second Reels, TikToks and Shorts that people watch to the end."
    items={[
      { title: 'Hook-first editing', description: 'Tight cuts that earn attention in 2 seconds.' },
      { title: 'Captions on every video', description: 'Most people watch on mute.' },
      { title: 'Transformation Reels', description: 'Before/after reveals and treatment journeys.' },
      { title: 'Your brand, every time', description: 'Logo, colours and fonts saved as presets.' },
    ]}
    image={{ src: '~/assets/images/demo/dentist-mask.jpg', alt: 'Dentist filming a Reel' }}
    callToAction={{ text: 'More about Reels', href: `${getPermalink('/services')}#reels` }}
  />

  <ServiceSlide
    id="testimonials"
    tagline="Core service 3"
    title="Patient testimonials"
    subtitle="Phone-filmed interviews cleaned up and cut into stories that build trust before the first visit."
    items={[
      { title: 'Phone footage is fine', description: 'Authentic beats polished.' },
      { title: 'Audio cleanup', description: 'Noise and echo removed, every word clear.' },
      { title: 'One interview, many assets', description: 'A full story plus 2–3 short clips.' },
      { title: 'Captions and name titles', description: 'In your brand style.' },
    ]}
    image={{ src: '~/assets/images/demo/treatment.jpg', alt: 'Patient in a dental chair' }}
    callToAction={{ text: 'More about testimonials', href: `${getPermalink('/services')}#testimonials` }}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-slate-50 dark:bg-transparent"></div>
    </Fragment>
  </ServiceSlide>

  <Reels
    id="video"
    tagline="Video samples"
    title="Reels, testimonials and ads"
    subtitle="Vertical edits with scroll-stopping hooks and burned-in captions."
    items={reels}
  />

  <Steps
    id="process"
    tagline="How it works"
    title="From phone to post in four steps"
    items={[
      {
        title: 'Shoot on any phone',
        description: 'Follow our free filming guide — no camera or studio needed.',
        icon: 'tabler:device-mobile',
      },
      {
        title: 'Upload',
        description: 'Share a Google Drive or Dropbox folder, or use the secure link we send you.',
        icon: 'tabler:upload',
      },
      {
        title: 'We edit',
        description: 'Your dedicated editor applies your brand and our compliance checklist. Two revisions included.',
        icon: 'tabler:adjustments',
      },
      {
        title: 'Post',
        description: 'Get files sized for Instagram, TikTok, YouTube, Facebook, your website and Google profile.',
        icon: 'tabler:rocket',
      },
    ]}
    image={{ src: '~/assets/images/pairs/clinic-after.jpg', alt: 'Bright dental treatment room' }}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-slate-50 dark:bg-transparent"></div>
    </Fragment>
  </Steps>

  <FAQs
    id="faq"
    tagline="FAQ"
    title="Questions practices and agencies ask us"
    schema
    items={[
      {
        title: 'Do we need a professional camera?',
        description:
          'No. A recent phone is enough. Our free guide shows your team how to shoot consistent before/afters and usable video.',
      },
      {
        title: 'Will you alter teeth to make results look better?',
        description:
          'Never. We correct photography only (light, colour, framing). Altering clinical results is misleading and breaks dental advertising rules.',
      },
      {
        title: 'Who is responsible for patient consent?',
        description:
          'The practice. You need written patient authorization to use their images in marketing. We include a consent checklist with every order and never show client work without permission.',
      },
      {
        title: 'How fast is delivery?',
        description: 'Photos in 24–48 hours, Reels in 48–72 hours. Same-day rush is available.',
      },
      {
        title: 'Do you work with agencies?',
        description: 'Yes. We work fully white-label with brand presets per clinic. See the agency page for details.',
      },
      {
        title: 'Can we try before committing?',
        description: 'Yes. Send 3 photos or one short clip and we will edit it free.',
      },
    ]}
  />

  <CallToAction
    title="See what we can do with your footage"
    subtitle="Send 3 photos or one clip. We'll edit it free and send it back within 48 hours. Not filming yet? Start with our free phone filming guide."
    actions={[
      { variant: 'primary', text: 'Start free trial', href: trial, icon: 'tabler:gift' },
      { text: 'Get the free guide', href: getPermalink('/guide'), icon: 'tabler:file-download' },
    ]}
  />

  <StickyCTA label="3 free edits — no strings" text="Free trial" href={trial} />
</Layout>
