---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import Content from '~/components/widgets/Content.astro';
import Features3 from '~/components/widgets/Features3.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import StickyCTA from '~/components/widgets/StickyCTA.astro';
import { getPermalink } from '~/utils/permalinks';

const metadata = {
  title: 'Services',
  description:
    'Before/after photo editing, clinical photo cleanup, headshot and office retouching, Reels, testimonial and smile reveal videos for dental practices.',
};
---

<Layout metadata={metadata}>
  <HeroText
    tagline="Services"
    title="Photo & video post-production, built for dentistry"
    subtitle="Every service follows your brand guide and our ethical editing policy: we correct photography, never clinical results."
    callToAction={{
      variant: 'primary',
      text: 'Get 3 free edits',
      href: `${getPermalink('/contact')}#trial`,
      icon: 'tabler:gift',
    }}
    callToAction2={{ text: 'See pricing', href: getPermalink('/pricing') }}
  />

  <Content
    id="photo"
    tagline="Photo"
    title="Before/after photo editing"
    items={[
      {
        title: 'Matched pairs',
        description: 'Same colour, exposure, angle and crop on both shots, so the only difference is the treatment.',
      },
      {
        title: 'Ready-made layouts',
        description: 'Side-by-side, stacked, slider-ready or carousel formats with your logo and watermark.',
      },
      {
        title: 'Every size you need',
        description: 'Website, Instagram (1:1, 4:5), Stories (9:16) and Google Business Profile.',
      },
    ]}
    image={{ src: '~/assets/images/pairs/smile-after.jpg', alt: 'Corrected smile photo', aspect: '4/3' }}
  />

  <Content
    isReversed
    title="Clinical & intraoral photo cleanup"
    items={[
      { title: 'Mirror shots fixed', description: 'Occlusal and buccal mirror images flipped and straightened.' },
      { title: 'Clean framing', description: 'Retractors, lips and fingers cropped out; contrast background evened.' },
      {
        title: 'Consistent series',
        description: 'A whole case set matched for case presentations, lectures and portfolios.',
      },
    ]}
    image={{ src: '~/assets/images/demo/implant-model.jpg', alt: 'Dental implant model', aspect: '4/3' }}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-slate-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <Content
    title="Headshots & office photos"
    items={[
      {
        title: 'Team portraits',
        description: 'True skin tones, clean backgrounds and a consistent look across the team.',
      },
      { title: 'Interiors', description: 'Bright, straight, welcoming treatment rooms and reception areas.' },
      {
        title: 'Light retouching',
        description: 'Natural results — stray hairs and distractions removed, people still look like themselves.',
      },
    ]}
    image={{ src: '~/assets/images/pairs/clinic-after.jpg', alt: 'Bright dental office', aspect: '4/3' }}
  />

  <Content
    id="video"
    isReversed
    tagline="Video"
    title="Reels, TikToks & YouTube Shorts"
    items={[
      { title: 'Hook-first editing', description: 'Tight cuts that get to the point in the first 2 seconds.' },
      { title: 'Captions on every video', description: 'Burned-in, on-brand captions — most people watch on mute.' },
      { title: 'Branded intro & outro', description: 'Your logo, colours and call-to-action on every video.' },
    ]}
    image={{ src: '~/assets/images/demo/dentist-mask.jpg', alt: 'Dentist filming a Reel', aspect: '4/3' }}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-slate-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <Features3
    title="More video services"
    columns={3}
    items={[
      {
        title: 'Patient testimonials',
        description: 'Audio cleanup, the best moments, captions and name titles. A full cut plus 2–3 short clips.',
        icon: 'tabler:message-circle-heart',
      },
      {
        title: 'Smile reveal videos',
        description: 'Before/after transitions, zoom reveals and patient-journey montages.',
        icon: 'tabler:sparkles',
      },
      {
        title: 'Doctor intro & clinic tour',
        description: 'Longer edits for your homepage, YouTube channel and Google Business Profile.',
        icon: 'tabler:video',
      },
      {
        title: 'Subtitles & translation',
        description: 'Accurate subtitles, including Spanish and other languages your patients speak.',
        icon: 'tabler:language',
      },
      {
        title: 'Social carousels',
        description: 'Multi-slide Instagram and Facebook posts built from your photos.',
        icon: 'tabler:layout-grid',
      },
      {
        title: 'Rush delivery',
        description: 'Same-day turnaround for launches, events and campaigns.',
        icon: 'tabler:bolt',
      },
    ]}
  />

  <CallToAction
    title="Not sure where to start?"
    subtitle="Send us 3 photos or a short clip. We'll edit it free and suggest what would work best for your practice."
    actions={[
      { variant: 'primary', text: 'Start free trial', href: `${getPermalink('/contact')}#trial`, icon: 'tabler:gift' },
    ]}
  />

  <StickyCTA label="3 free edits — no strings" text="Free trial" href={`${getPermalink('/contact')}#trial`} />
</Layout>
