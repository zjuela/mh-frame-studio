---
import Layout from '~/layouts/PageLayout.astro';
import Hero2 from '~/components/widgets/Hero2.astro';
import Features2 from '~/components/widgets/Features2.astro';
import ServiceSlide from '~/components/widgets/ServiceSlide.astro';
import Steps2 from '~/components/widgets/Steps2.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import { getPermalink } from '~/utils/permalinks';

const metadata = {
  title: 'White-Label Editing for Dental Marketing Agencies',
  description:
    'White-label video and photo editing for dental marketing agencies: Reels, testimonials, before/afters and Meta ad creatives with hook variations.',
};

const call = `${getPermalink('/contact')}#agency`;
const trial = `${getPermalink('/contact')}#trial`;
const galleries = getPermalink('/work');
---

<Layout metadata={metadata} slides>
  <Hero2
    tagline="For dental marketing agencies"
    title="Add a dental editing team without hiring one"
    subtitle="We edit Reels, testimonials, before/afters and Meta ads for all your dental clients — under your brand, with overnight turnaround. You keep the client and the margin."
    actions={[
      { variant: 'primary', text: 'Book a 15-min call', href: call, icon: 'tabler:calendar' },
      { text: 'Free test project', href: trial },
    ]}
    image={{ src: '~/assets/images/pairs/consult-after.jpg', alt: 'Dentist with a patient' }}
  />

  <Features2
    tagline="What you can hand off"
    title="Everything your dental clients need edited"
    columns={2}
    items={[
      {
        title: 'Reels, TikToks & Shorts',
        description: "Educational, behind-the-scenes and transformation Reels from your clients' phone footage.",
        icon: 'tabler:device-mobile',
        href: `${galleries}#reels`,
      },
      {
        title: 'Patient testimonials',
        description: 'Full story cut plus short clips for organic posts and ads. Audio cleaned, captions added.',
        icon: 'tabler:message-circle-heart',
        href: `${galleries}#testimonials`,
      },
      {
        title: 'Compliance-ready before/afters',
        description: 'Matched, unaltered pairs with procedure labels — less risk for you and your clients.',
        icon: 'tabler:photo-check',
        href: `${galleries}#before-after`,
      },
      {
        title: 'Meta ad creatives',
        description: 'Talking-head and user-generated-style ads with hook variations, ready for testing.',
        icon: 'tabler:speakerphone',
        href: '#ad-creatives',
      },
    ]}
  />

  <ServiceSlide
    id="ad-creatives"
    isReversed
    tagline="Built for paid social"
    title="Ad creatives with hook variations"
    subtitle="Talking-head and user-generated-style ads for Facebook and Instagram, built for testing."
    items={[
      {
        title: '3 hooks per ad',
        description: 'Each ad comes in 3 opening variations so you can test what stops the scroll.',
      },
      {
        title: 'Formats for every placement',
        description: '9:16 for Reels and Stories, 4:5 and 1:1 for feeds — from the same edit.',
      },
      {
        title: 'Iterate on results',
        description: 'Send us watch-time and drop-off data; we re-cut winners and replace losers.',
      },
      {
        title: 'Platform-aware',
        description: 'Ad versions avoid side-by-side before/afters where ad platforms restrict them.',
      },
    ]}
    image={{ src: '~/assets/images/demo/headshot-2.jpg', alt: 'Dentist talking to camera' }}
    callToAction={{ text: 'See ad samples', href: `${galleries}#ad-creatives` }}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-slate-50 dark:bg-transparent"></div>
    </Fragment>
  </ServiceSlide>

  <Features2
    tagline="How we work with agencies"
    title="Built to scale with your client list"
    columns={3}
    items={[
      {
        title: '100% white-label',
        description: 'No logos, watermarks or mentions of us. We never contact your clients.',
        icon: 'tabler:tag-off',
      },
      {
        title: 'Brand presets per clinic',
        description: 'Fonts, colours, logos, caption styles and intros saved for each clinic.',
        icon: 'tabler:palette',
      },
      {
        title: 'Same editor every month',
        description: 'One editor who learns your clinics — no re-explaining, no quality swings.',
        icon: 'tabler:user-check',
      },
      {
        title: 'Overnight & same-day',
        description: 'Send work at the end of your day, have it back the next morning. Same-day rush available.',
        icon: 'tabler:moon',
      },
      {
        title: 'Live review calls',
        description: 'Jump on a quick call to review edits together when a project needs it.',
        icon: 'tabler:video',
      },
      {
        title: 'Your tools',
        description: 'Slack, Teams, Trello, Frame.io or your project tool. We fit your workflow.',
        icon: 'tabler:brand-slack',
      },
    ]}
  />

  <Steps2
    tagline="Getting started"
    title="Onboarding takes one call"
    items={[
      {
        title: 'Intro call',
        description: '15 minutes on your clinics, volumes and deliverables.',
        icon: 'tabler:phone',
      },
      {
        title: 'Free test project',
        description: 'We edit a real batch from one of your clients, free.',
        icon: 'tabler:flask',
      },
      {
        title: 'Brand presets',
        description: 'We set up a style guide for each clinic you send.',
        icon: 'tabler:palette',
      },
      { title: 'Go live', description: 'Send work any time; we deliver under your brand.', icon: 'tabler:rocket' },
    ]}
  />

  <FAQs
    title="Agency FAQ"
    items={[
      {
        title: 'Will our clients ever know about you?',
        description: 'No. We never contact your clients and never put our name on deliverables.',
      },
      {
        title: 'Can you sign an NDA, BAA or DPA?',
        description: 'Yes. We are happy to sign your NDA and data processing agreements before any files are shared.',
      },
      {
        title: 'How do you price agency work?',
        description:
          'Wholesale per-clinic or per-item pricing that leaves room for your markup, with volume discounts as you add clinics. No setup fee.',
      },
      {
        title: 'What volume can you handle?',
        description:
          'Tell us your monthly volume on the intro call and we will plan capacity and turnaround around it.',
      },
    ]}
  />

  <CallToAction
    title="Let's run a free test project"
    subtitle="Send a real batch from one of your dental clients. Judge the work, then decide."
    actions={[
      { variant: 'primary', text: 'Book a call', href: call, icon: 'tabler:calendar' },
      { text: 'See galleries', href: galleries },
    ]}
  />
</Layout>
