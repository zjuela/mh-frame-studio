---
import type { ImageMetadata } from 'astro';
import Image from '~/components/common/Image.astro';
import Headline from '~/components/ui/Headline.astro';
import SamplePlaceholder from '~/components/ui/SamplePlaceholder.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import { getAsset } from '~/utils/permalinks';
import type { Widget } from '~/types';

// Vertical (9:16) video showcase. Each card shows a poster styled like a
// finished Reel. A card becomes playable in two ways:
// - `video`: an MP4 in `public/` (e.g. 'videos/grinding.mp4') that plays in
//   the card when clicked.
// - `href`: a published sample (YouTube Short, Vimeo, Instagram…) that opens
//   in a new tab.
// Without either, the card is a still preview and shows no play button.

export interface Reel {
  poster: ImageMetadata;
  alt: string;
  hook: string;
  caption: string;
  label: string;
  duration?: string;
  video?: string;
  href?: string;
}

export interface Props extends Widget {
  title?: string;
  subtitle?: string;
  tagline?: string;
  items: Reel[];
  /** Slots for videos not ready yet, shown after the real ones. */
  placeholders?: string[];
}

const {
  title,
  subtitle,
  tagline,
  items = [],
  placeholders = [],
  id,
  isDark = false,
  classes = {},
  bg = await Astro.slots.render('bg'),
} = Astro.props;

const cardClass =
  'group relative block aspect-[9/16] w-[70vw] max-w-[280px] shrink-0 snap-center overflow-hidden rounded-2xl bg-slate-900 shadow-lg ring-1 ring-black/10 md:w-auto md:max-w-none';
const playIconClass =
  'mb-3 flex h-12 w-12 items-center justify-center rounded-full bg-white/90 text-slate-900 shadow transition group-hover:scale-110';
---

<WidgetWrapper id={id} isDark={isDark} containerClass={classes?.container as string} bg={bg}>
  <Headline title={title} subtitle={subtitle} tagline={tagline} />
  <div
    class="-mx-4 flex snap-x snap-mandatory gap-4 overflow-x-auto px-4 pb-4 md:mx-0 md:grid md:grid-cols-4 md:gap-6 md:overflow-visible md:px-0"
  >
    {
      items.map((reel) => {
        const Tag = reel.video ? 'aw-reel' : reel.href ? 'a' : 'div';
        const playIcon = (
          <svg viewBox="0 0 24 24" class="ml-0.5 h-6 w-6" fill="currentColor" aria-hidden="true">
            <path d="M8 5v14l11-7z" />
          </svg>
        );
        return (
          <Tag
            {...(reel.href && !reel.video ? { href: reel.href, target: '_blank', rel: 'noopener noreferrer' } : {})}
            class={cardClass}
          >
            <Image
              src={reel.poster}
              alt={reel.alt}
              widths={[320, 480, 640]}
              sizes="(max-width: 767px) 70vw, 25vw"
              layout="none"
              format="webp"
              class="absolute inset-0 h-full w-full object-cover transition duration-500 group-hover:scale-105"
            />
            {reel.video && (
              <video
                class="absolute inset-0 h-full w-full bg-black object-cover"
                src={getAsset(reel.video)}
                preload="none"
                playsinline
                hidden
              />
            )}
            <div data-overlay class="absolute inset-0">
              <div class="absolute inset-0 bg-gradient-to-b from-black/30 via-transparent to-black/75" />

              <span class="absolute left-3 top-3 rounded-full bg-white/90 px-2.5 py-1 text-[11px] font-semibold uppercase tracking-wide text-slate-800">
                {reel.label}
              </span>
              {reel.duration && (
                <span class="absolute right-3 top-3 rounded bg-black/60 px-1.5 py-0.5 text-[11px] font-medium text-white">
                  {reel.duration}
                </span>
              )}

              <p class="absolute inset-x-4 top-[38%] text-center text-lg font-extrabold leading-snug text-white [text-shadow:0_2px_8px_rgb(0_0_0/0.6)]">
                <span class="box-decoration-clone rounded bg-accent px-1.5 py-0.5">{reel.hook}</span>
              </p>

              <div class="absolute inset-x-0 bottom-0 p-4">
                {reel.video ? (
                  <button type="button" aria-label={`Play: ${reel.hook}`} class={`${playIconClass} cursor-pointer`}>
                    {playIcon}
                  </button>
                ) : reel.href ? (
                  <div class={playIconClass}>{playIcon}</div>
                ) : null}
                <p class="text-sm font-medium text-white">{reel.caption}</p>
              </div>
            </div>
          </Tag>
        );
      })
    }
    {
      placeholders.map((label) => (
        <SamplePlaceholder
          label={label}
          aspect="9/16"
          class="w-[70vw] max-w-[280px] shrink-0 snap-center md:w-auto md:max-w-none"
        />
      ))
    }
  </div>
</WidgetWrapper>

<script>
  // Plays the card's video in place; when it ends, the poster comes back.
  class AwReel extends HTMLElement {
    connectedCallback() {
      const video = this.querySelector('video');
      const overlay = this.querySelector<HTMLElement>('[data-overlay]');
      const button = this.querySelector('button');
      if (!video || !overlay || !button) return;
      button.addEventListener('click', () => {
        video.hidden = false;
        video.controls = true;
        overlay.hidden = true;
        video.play();
      });
      video.addEventListener('ended', () => {
        video.hidden = true;
        video.controls = false;
        overlay.hidden = false;
      });
    }
  }

  if (!customElements.get('aw-reel')) customElements.define('aw-reel', AwReel);
</script>
