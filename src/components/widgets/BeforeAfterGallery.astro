---
import type { ImageMetadata } from 'astro';
import BeforeAfter from '~/components/ui/BeforeAfter.astro';
import Headline from '~/components/ui/Headline.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import type { Widget } from '~/types';

export interface BeforeAfterItem {
  before: ImageMetadata;
  after: ImageMetadata;
  alt: string;
  title: string;
  description?: string;
  fixes?: string[];
}

export interface Props extends Widget {
  title?: string;
  subtitle?: string;
  tagline?: string;
  items: BeforeAfterItem[];
  columns?: 1 | 2;
}

const { title, subtitle, tagline, items = [], columns = 2, id, isDark = false, classes = {} } = Astro.props;
---

<WidgetWrapper id={id} isDark={isDark} containerClass={classes?.container as string}>
  <Headline title={title} subtitle={subtitle} tagline={tagline} />
  <div class:list={['grid gap-10 md:gap-12', { 'md:grid-cols-2': columns === 2 }]}>
    {
      items.map((item) => (
        <figure>
          <BeforeAfter before={item.before} after={item.after} alt={item.alt} />
          <figcaption class="mt-4">
            <h3 class="text-lg font-semibold text-heading">{item.title}</h3>
            {item.description && <p class="mt-1 text-muted">{item.description}</p>}
            {item.fixes?.length ? (
              <ul class="mt-3 flex flex-wrap gap-2">
                {item.fixes.map((fix) => (
                  <li class="rounded-full bg-primary/10 px-3 py-1 text-xs font-medium text-primary dark:text-secondary">
                    {fix}
                  </li>
                ))}
              </ul>
            ) : null}
          </figcaption>
        </figure>
      ))
    }
  </div>
  <p class="mt-10 text-center text-sm text-muted">
    Drag the handle to compare. Demo samples use licensed stock photos; we correct photography only, never clinical
    results.
  </p>
</WidgetWrapper>
