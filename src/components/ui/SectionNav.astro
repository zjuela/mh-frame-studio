---
// A pill-shaped bar of links that jump to the sections of a long page. It
// sticks below the header while scrolling and highlights the section in view.
// On phones the links scroll sideways inside the pill.

export interface Props {
  items: Array<{ text: string; href: `#${string}` }>;
  label?: string;
}

const { items, label = 'On this page' } = Astro.props;
---

<aw-section-nav class="pointer-events-none sticky top-[78px] z-30 block px-4">
  <nav
    aria-label={label}
    class="pointer-events-auto mx-auto w-fit max-w-full rounded-full border border-gray-200 bg-white/90 shadow-md backdrop-blur dark:border-slate-700 dark:bg-slate-900/90"
  >
    <ul class="flex gap-1 overflow-x-auto rounded-full p-1">
      {
        items.map(({ text, href }) => (
          <li class="shrink-0">
            <a
              href={href}
              class="inline-flex min-h-11 items-center rounded-full px-4 text-sm font-medium text-default transition-colors duration-200 hover:bg-primary/10 hover:text-primary focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-primary aria-[current=true]:bg-primary aria-[current=true]:text-white"
            >
              {text}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</aw-section-nav>

<style is:global>
  /* Land section headings below the header and this bar. */
  main section[id] {
    scroll-margin-top: 140px;
  }
</style>

<script>
  class AwSectionNav extends HTMLElement {
    private observer?: IntersectionObserver;

    connectedCallback() {
      const links = [...this.querySelectorAll<HTMLAnchorElement>('a[href^="#"]')];
      const sections = links
        .map((link) => document.getElementById(link.hash.slice(1)))
        .filter((el): el is HTMLElement => !!el);
      // The section crossing a line just below the bar is the current one.
      this.observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            links.forEach((link) => link.setAttribute('aria-current', String(link.hash === `#${entry.target.id}`)));
          }
        },
        { rootMargin: '-150px 0px -60% 0px' }
      );
      sections.forEach((section) => this.observer!.observe(section));
    }

    disconnectedCallback() {
      this.observer?.disconnect();
    }
  }

  if (!customElements.get('aw-section-nav')) customElements.define('aw-section-nav', AwSectionNav);
</script>
