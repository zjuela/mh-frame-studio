---
import type { ImageMetadata } from 'astro';
import Image from '~/components/common/Image.astro';

// Finished before/after images (made by scripts/make-before-after.mjs) shown
// whole inside a 4:3 frame. Clicking one opens a full-size viewer on the
// page; every image with the same `group` can be stepped through with the
// arrow keys, the on-screen buttons or a swipe. Without JavaScript the
// links simply open the image.

export interface Props {
  posts: Array<{ image: ImageMetadata; alt: string }>;
  group?: string;
  class?: string;
}

const { posts, group = 'posts', class: className = '' } = Astro.props;
// Longer carousels sit in a 3-across grid instead of one row of tiny slides.
const grid = posts.length > 3;
---

<div
  class:list={[
    'aspect-[4/3] gap-3 overflow-hidden rounded-xl bg-slate-100 p-4 shadow-lg ring-1 ring-black/5 dark:bg-slate-800',
    grid ? 'grid grid-cols-3 grid-rows-2 place-items-center' : 'flex items-center justify-center',
    className,
  ]}
>
  {
    posts.map(({ image, alt }) => (
      <a
        href={image.src}
        data-lightbox={group}
        data-caption={alt}
        class="flex h-full min-h-0 min-w-0 cursor-zoom-in items-center justify-center rounded-md focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
      >
        <Image
          src={image}
          alt={alt}
          widths={[480, 800, 1200]}
          sizes={grid ? '(max-width: 767px) 33vw, 220px' : '(max-width: 767px) 100vw, 640px'}
          layout="none"
          format="webp"
          class="max-h-full w-auto max-w-full rounded-md object-contain shadow transition duration-200 hover:shadow-lg"
        />
      </a>
    ))
  }
</div>

<script>
  // One viewer per page, built on first use around a native <dialog>, which
  // gives focus trapping, Escape to close and a backdrop for free.
  let dialog: HTMLDialogElement | undefined;
  let items: HTMLAnchorElement[] = [];
  let index = 0;

  const buttonClass =
    'absolute flex h-11 w-11 cursor-pointer items-center justify-center rounded-full bg-white/90 text-slate-900 shadow transition-colors duration-200 hover:bg-white focus-visible:outline-2 focus-visible:outline-white';
  const icon = (d: string) =>
    `<svg viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="${d}"/></svg>`;

  function build() {
    const el = document.createElement('dialog');
    el.className =
      'm-auto max-h-none max-w-none bg-transparent p-0 backdrop:bg-black/85 h-[100svh] w-screen overflow-hidden';
    el.setAttribute('aria-label', 'Image viewer');
    el.innerHTML = `
      <figure class="flex h-full w-full flex-col items-center justify-center gap-3 p-4 md:p-10">
        <img class="max-h-[85svh] max-w-full rounded-lg object-contain shadow-2xl" alt="" />
        <figcaption class="text-center text-sm text-white/90"></figcaption>
      </figure>
      <button type="button" data-close aria-label="Close" class="${buttonClass} right-4 top-4">${icon('M18 6 6 18M6 6l12 12')}</button>
      <button type="button" data-prev aria-label="Previous image" class="${buttonClass} left-4 top-1/2 -translate-y-1/2">${icon('m15 18-6-6 6-6')}</button>
      <button type="button" data-next aria-label="Next image" class="${buttonClass} right-4 top-1/2 -translate-y-1/2">${icon('m9 18 6-6-6-6')}</button>`;
    el.querySelector('[data-close]')!.addEventListener('click', () => el.close());
    el.querySelector('[data-prev]')!.addEventListener('click', () => show(index - 1));
    el.querySelector('[data-next]')!.addEventListener('click', () => show(index + 1));
    // A click on the dark area around the image closes the viewer.
    el.addEventListener('click', (event) => {
      const target = event.target as HTMLElement;
      if (target === el || target.tagName === 'FIGURE') el.close();
    });
    el.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowLeft') show(index - 1);
      if (event.key === 'ArrowRight') show(index + 1);
    });
    let startX = 0;
    el.addEventListener('pointerdown', (event) => (startX = event.clientX));
    el.addEventListener('pointerup', (event) => {
      const dx = event.clientX - startX;
      if (Math.abs(dx) > 50) show(index + (dx < 0 ? 1 : -1));
    });
    el.addEventListener('close', () => items[index]?.focus());
    document.body.append(el);
    return el;
  }

  function show(i: number) {
    if (!dialog || !items.length) return;
    index = (i + items.length) % items.length;
    const link = items[index];
    const img = dialog.querySelector('img')!;
    img.src = link.href;
    img.alt = link.dataset.caption ?? '';
    dialog.querySelector('figcaption')!.textContent = link.dataset.caption ?? '';
    const single = items.length < 2;
    dialog.querySelectorAll<HTMLElement>('[data-prev], [data-next]').forEach((b) => (b.hidden = single));
  }

  // Capture phase, so this runs before the page-transition router, which
  // would otherwise treat the click as a page navigation.
  document.addEventListener(
    'click',
    (event) => {
      const link = (event.target as HTMLElement).closest<HTMLAnchorElement>('a[data-lightbox]');
      if (!link || event.metaKey || event.ctrlKey || event.shiftKey) return;
      event.preventDefault();
      dialog ??= build();
      items = [...document.querySelectorAll<HTMLAnchorElement>(`a[data-lightbox="${link.dataset.lightbox}"]`)];
      show(items.indexOf(link));
      dialog.showModal();
    },
    true
  );
</script>
