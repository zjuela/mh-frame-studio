  <svg class="h-8 w-8 shrink-0" viewBox="0 0 32 32" aria-hidden="true">
    <rect width="32" height="32" rx="8" class="fill-primary"></rect>
    <path d="M8 9h7v14H8z" fill="white" opacity="0.55"></path>
    <path d="M17 9h7v14h-7z" fill="white"></path>
    <path d="M16 6v20" stroke="white" stroke-width="1.5"></path>
  </svg>
  <span class="text-xl font-bold tracking-tight text-heading">{SITE?.name}</span>
</span>
