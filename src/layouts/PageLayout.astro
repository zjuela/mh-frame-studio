---
import Layout from '~/layouts/Layout.astro';
import Header from '~/components/widgets/Header.astro';
import Footer from '~/components/widgets/Footer.astro';
import Announcement from '~/components/widgets/Announcement.astro';

import { headerData, footerData } from '~/navigation';
import { getPermalink } from '~/utils/permalinks';

import type { MetaData } from '~/types';

export interface Props {
  metadata?: MetaData;
  /** Slide mode: see Layout. The announcement bar is left out so the hero fills the first screen. */
  slides?: boolean;
}

const { metadata, slides = false } = Astro.props;
---

<Layout metadata={metadata} slides={slides}>
  <slot name="head" slot="head" />
  {
    /*
    Slot fallbacks are rendered explicitly. With `<slot name="x">fallback</slot>`
    Astro still evaluates the fallback when the page overrides the slot, and
    astro-icon then believes the icons inside it (the RSS icon of the default
    header, for instance) were already emitted, so their SVG sprite symbol
    goes missing on that page.
  */
  }
  {
    slides ? null : Astro.slots.has('announcement') ? (
      <slot name="announcement" />
    ) : (
      <Announcement
        badge="FREE TRIAL"
        text="Send us 3 photos — we'll edit them free, no strings attached »"
        href={`${getPermalink('/contact')}#trial`}
        showStars={false}
      />
    )
  }
  {Astro.slots.has('header') ? <slot name="header" /> : <Header {...headerData} isSticky />}
  <main class="flex-1">
    <slot />
  </main>
  {Astro.slots.has('footer') ? <slot name="footer" /> : <Footer {...footerData} />}
</Layout>
